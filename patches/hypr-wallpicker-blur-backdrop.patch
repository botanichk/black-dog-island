+// --- фон под миниатюрами --------------------------------------------------
+// Зачем: окно выбора прозрачное, и 32 яркие миниатюры поверх пёстрых обоев
+// дают цветовую кашу. Размытые и притемнённые обои узнаются, но перестают
+// спорить с миниатюрами.
+//
+// Как размываем: без шейдеров и без снятия экрана. Берём сам файл обоев,
+// уменьшаем в downscale раз, потом растягиваем обратно до размера экрана.
+// Уменьшение усредняет соседние пиксели (stb_image_resize, линейный фильтр),
+// растягивание сглаживает - вместе это ровное размытие. Стоимость: один
+// проход по картинке при открытии окна, на Intel HD 4000 незаметно.
+static Image BlurImage(Image img, int downscale) {
+  int w = img.width;
+  int h = img.height;
+  int small_w = w / downscale;
+  int small_h = h / downscale;
+
+  if (downscale < 2 || small_w < 1 || small_h < 1) {
+    return img;
+  }
+
+  ImageResize(&img, small_w, small_h);
+  ImageResize(&img, w, h);
+  return img;
+}
+
+bool LoadBackdrop(App *app, const char *path, int downscale, int scrim_percent) {
+  Image img;
+  int win_w;
+  int win_h;
+  float src_aspect;
+  float win_aspect;
+  Rectangle crop;
+  int keep;
+
+  if (app == NULL || path == NULL) {
+    return false;
+  }
+
+  img = LoadImage(path);
+  if (img.data == NULL) {
+    return false;
+  }
+
+  // Приводим к RGB(8)A: ImageResize и текстура работают с известным форматом.
+  ImageFormat(&img, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8);
+
+  win_w = GetScreenWidth();
+  win_h = GetScreenHeight();
+  if (win_w < 1 || win_h < 1) {
+    UnloadImage(img);
+    return false;
+  }
+
+  // Кадрируем по пропорциям экрана, как xfdesktop в режиме zoom: иначе
+  // растянутая на весь экран картинка была бы сплющена.
+  // keep целым: ImageCrop в raylib при дробных width/height выделяет буфер
+  // меньше, чем копирует, - на 8K-обоях порча кучи (free(): invalid size).
+  src_aspect = (float)img.width / (float)img.height;
+  win_aspect = (float)win_w / (float)win_h;
+  if (src_aspect > win_aspect) {
+    keep = (int)((float)img.height * win_aspect);
+    crop = (Rectangle){(float)((img.width - keep) / 2), 0.0f, (float)keep,
+                       (float)img.height};
+  } else {
+    keep = (int)((float)img.width / win_aspect);
+    crop = (Rectangle){0.0f, (float)((img.height - keep) / 2),
+                       (float)img.width, (float)keep};
+  }
+  ImageCrop(&img, crop);
+
+  // Уменьшаем и растягиваем обратно до размеров экрана.
+  ImageResize(&img, win_w, win_h);
+  img = BlurImage(img, downscale);
+
+  // Затемнение делаем в САМИХ пикселях, а не полупрозрачным прямоугольником
+  // поверх. Полупрозрачный прямоугольник на прозрачном окне не затемняет, а
+  // делает всё окно полупрозрачным: рабочий стол просвечивает, и вместо
+  // затемнения получается разбавление (проверено: просили 40%, на экране
+  // вышло посветление на 40%).
+  //
+  // Правку делаем прямо в img.data, а не через LoadImageColors: тот отдаёт
+  // КОПИЮ пикселей (проверено - изменения в ней до текстуры не доходят).
+  // Формат уже R8G8B8A8, поэтому байты идут подряд: R,G,B,A на пиксель.
+  if (scrim_percent > 0) {
+    float k = 1.0f - (float)scrim_percent / 100.0f;
+    unsigned char *px = (unsigned char *)img.data;
+    int bytes = img.width * img.height * 4;
+    for (int i = 0; i < bytes; i += 4) {
+      px[i + 0] = (unsigned char)((float)px[i + 0] * k + 0.5f);
+      px[i + 1] = (unsigned char)((float)px[i + 1] * k + 0.5f);
+      px[i + 2] = (unsigned char)((float)px[i + 2] * k + 0.5f);
+      px[i + 3] = 255; // фон непрозрачный: под ним не должно быть стола
+    }
+  }
+
+  app->backdrop_tex = LoadTextureFromImage(img);
+  UnloadImage(img);
+
+  if (app->backdrop_tex.id == 0) {
+    return false;
+  }
+
+  // Билинейная фильтрация: текстура почти всегда рисуется не в масштабе 1:1
+  // (экран и размер окна могут разойтись), и без неё были бы пиксельные
+  // ступеньки на градиентах.
+  SetTextureFilter(app->backdrop_tex, TEXTURE_FILTER_BILINEAR);
+  return true;
+}
+
+void UnloadBackdrop(App *app) {
+  if (app == NULL) {
+    return;
+  }
+
+  if (app->backdrop_tex.id != 0) {
+    UnloadTexture(app->backdrop_tex);
+    app->backdrop_tex = (Texture2D){0};
+  }
+}
