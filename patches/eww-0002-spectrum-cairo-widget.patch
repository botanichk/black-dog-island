+//! `spectrum` — визуализатор одним проходом cairo.
+//!
+//! Зачем свой виджет. Раньше 24 полосы были 96 отдельными box: Eww на каждом
+//! кадре пересчитывал раскладку окна, и демон упирался в 100 % ядра, а экран
+//! показывал единицы кадров. Здесь кадр = одна перерисовка (queue_draw), как
+//! paintEvent в radiofm/radio/viz/spectrum.py, поэтому цена кадра не зависит
+//! от числа полос.
+//!
+//! Геометрия (принята владельцем): полосы лежат друг под другом, растут от
+//! общей вертикали влево и вправо, на внешнем конце - точка пика, которая
+//! отходит от линии, когда уровень упал. Толщина полоски равна диаметру
+//! шарика, щель между концом полоски и шариком - один шарик. Постоянной оси
+//! нет: на тишине шарики собираются у центра и читаются как вертикальный
+//! пунктир, который еле колышется.
+
+use std::cell::RefCell;
+use std::f64::consts::PI;
+
+use anyhow::{anyhow, Result};
+use gtk::glib::{self, object_subclass, wrapper, Properties};
+use gtk::{cairo, prelude::*, subclass::prelude::*};
+
+use crate::error_handling_ctx;
+
+wrapper! {
+    pub struct Spectrum(ObjectSubclass<SpectrumPriv>)
+    @extends gtk::Bin, gtk::Container, gtk::Widget;
+}
+
+#[derive(Properties, Default)]
+#[properties(wrapper_type = Spectrum)]
+pub struct SpectrumPriv {
+    /// Кадр: {"v":[уровни 0..1], "p":[точки пика 0..1]}
+    #[property(get, set, nick = "Data", blurb = "JSON frame with v and p arrays", default = "")]
+    data: RefCell<String>,
+
+    /// Градиент по частоте: 4 цвета через запятую (ramp темы radiofm).
+    #[property(
+        get,
+        set,
+        nick = "Ramp",
+        blurb = "Comma separated hex colours",
+        default = "#3dd8ff,#4b82ff,#965fff,#e256ff"
+    )]
+    ramp: RefCell<String>,
+}
+
+impl ObjectImpl for SpectrumPriv {
+    fn properties() -> &'static [glib::ParamSpec] {
+        Self::derived_properties()
+    }
+
+    fn set_property(&self, _id: usize, value: &glib::Value, pspec: &glib::ParamSpec) {
+        match pspec.name() {
+            "data" => {
+                let data: String = value.get().unwrap();
+                // Тот же кадр — перерисовывать нечего.
+                if *self.data.borrow() != data {
+                    self.data.replace(data);
+                    self.obj().queue_draw();
+                }
+            }
+            "ramp" => {
+                self.ramp.replace(value.get().unwrap());
+                self.obj().queue_draw();
+            }
+            x => panic!("Tried to set inexistant property of Spectrum: {}", x),
+        }
+    }
+
+    fn property(&self, id: usize, pspec: &glib::ParamSpec) -> glib::Value {
+        self.derived_property(id, pspec)
+    }
+}
+
+#[object_subclass]
+impl ObjectSubclass for SpectrumPriv {
+    type ParentType = gtk::Bin;
+    type Type = Spectrum;
+
+    const NAME: &'static str = "Spectrum";
+
+    fn class_init(klass: &mut Self::Class) {
+        klass.set_css_name("spectrum");
+    }
+}
+
+impl Default for Spectrum {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl Spectrum {
+    pub fn new() -> Self {
+        glib::Object::new::<Self>()
+    }
+}
+
+impl ContainerImpl for SpectrumPriv {
+    fn add(&self, _widget: &gtk::Widget) {
+        error_handling_ctx::print_error(anyhow!("Error, Spectrum widget should not have any children"));
+    }
+}
+
+impl BinImpl for SpectrumPriv {}
+
+impl WidgetImpl for SpectrumPriv {
+    // Без этого GtkBin просит размер у ребёнка, ребёнка нет - виджет получает
+    // 0x0 и draw не вызывается вовсе. graph.rs по этой же причине задаёт
+    // preferred_* явно.
+    fn preferred_width(&self) -> (i32, i32) {
+        (1, i32::MAX)
+    }
+
+    fn preferred_height(&self) -> (i32, i32) {
+        (1, i32::MAX)
+    }
+
+    fn draw(&self, cr: &cairo::Context) -> glib::Propagation {
+        let res: Result<()> = (|| {
+            let styles = self.obj().style_context();
+            let margin = styles.margin(gtk::StateFlags::NORMAL);
+            let width = self.obj().allocated_width() as f64 - margin.left as f64 - margin.right as f64;
+            let height = self.obj().allocated_height() as f64 - margin.top as f64 - margin.bottom as f64;
+            if width <= 1.0 || height <= 1.0 {
+                return Ok(());
+            }
+
+            let raw = self.data.borrow().clone();
+            let (values, peaks) = parse_frame(&raw);
+            let n = values.len().max(1);
+
+            let ramp = parse_ramp(&self.ramp.borrow());
+            let cx = width / 2.0;
+            let row_h = height / n as f64;
+            // Шарик задаёт масштаб: полоска толщиной ровно в его диаметр, и
+            // между концом полоски и шариком остаётся ещё один диаметр пустоты.
+            let dot_r = (row_h * 0.20).clamp(1.6, 3.2);
+            let thick = dot_r * 2.0;
+            // Край: полоска, щель в шарик и сам шарик.
+            let max_half = (width / 2.0 - thick - dot_r).max(1.0);
+
+            cr.save()?;
+            cr.translate(margin.left as f64, margin.top as f64);
+            cr.set_line_cap(cairo::LineCap::Round);
+
+            for i in 0..n {
+                let level = values.get(i).copied().unwrap_or(0.0).clamp(0.0, 1.0);
+                let peak = peaks.get(i).copied().unwrap_or(level).clamp(0.0, 1.0);
+                let (r, g, b) = ramp_at(&ramp, if n > 1 { i as f64 / (n - 1) as f64 } else { 0.0 });
+                let y = row_h * (i as f64 + 0.5);
+
+                let ray = level * max_half;
+                if ray > 0.5 {
+                    cr.set_source_rgba(r, g, b, 1.0);
+                    cr.set_line_width(thick);
+                    cr.move_to(cx - ray, y);
+                    cr.line_to(cx + ray, y);
+                    cr.stroke()?;
+                }
+
+                // Точка пика висит за концом полоски на один шарик. Когда
+                // уровень упал, она отходит дальше и медленно догоняет его -
+                // вид radiofm. На тишине полосок нет, и все точки стоят по
+                // центру одной вертикалью: это и есть пунктирная линия,
+                // которая еле колышется вместе с уровнем.
+                let dx = peak * max_half + thick + dot_r;
+                cr.set_source_rgba(r, g, b, 1.0);
+                if peak < 0.05 {
+                    // Тишина: одна точка в центре, иначе линия была бы двойной.
+                    cr.new_sub_path();
+                    cr.arc(cx + peak * max_half, y, dot_r, 0.0, 2.0 * PI);
+                } else {
+                    for x in [cx - dx, cx + dx] {
+                        cr.new_sub_path();
+                        cr.arc(x, y, dot_r, 0.0, 2.0 * PI);
+                    }
+                }
+                cr.fill()?;
+            }
+
+            cr.restore()?;
+            Ok(())
+        })();
+
+        if let Err(error) = res {
+            error_handling_ctx::print_error(error)
+        }
+
+        glib::Propagation::Proceed
+    }
+}
+
+/// Кадр → (уровни, пики). Мусор в данных — пустые массивы, виджет не падает.
+fn parse_frame(raw: &str) -> (Vec<f64>, Vec<f64>) {
+    let Ok(frame) = serde_json::from_str::<serde_json::Value>(raw) else {
+        return (Vec::new(), Vec::new());
+    };
+    let read = |key: &str| -> Vec<f64> {
+        frame
+            .get(key)
+            .and_then(|v| v.as_array())
+            .map(|a| a.iter().map(|x| x.as_f64().unwrap_or(0.0)).collect())
+            .unwrap_or_default()
+    };
+    let values = read("v");
+    let peaks = read("p");
+    (values, peaks)
+}
+
+/// "#rrggbb,#rrggbb,..." → список цветов. Мусор пропускается.
+fn parse_ramp(spec: &str) -> Vec<(f64, f64, f64)> {
+    let colors: Vec<(f64, f64, f64)> = spec.split(',').filter_map(parse_hex).collect();
+    if colors.is_empty() { vec![(0.3, 0.7, 1.0)] } else { colors }
+}
+
+fn parse_hex(raw: &str) -> Option<(f64, f64, f64)> {
+    let s = raw.trim().trim_start_matches('#');
+    let expand = |c: &str| u8::from_str_radix(c, 16).ok().map(|v| v as f64 / 255.0);
+    match s.len() {
+        6 => Some((expand(&s[0..2])?, expand(&s[2..4])?, expand(&s[4..6])?)),
+        3 => Some((
+            expand(&s[0..1].repeat(2))?,
+            expand(&s[1..2].repeat(2))?,
+            expand(&s[2..3].repeat(2))?,
+        )),
+        _ => None,
+    }
+}
+
+/// Градиент по позиции 0..1, как ramp() темы radiofm.
+fn ramp_at(ramp: &[(f64, f64, f64)], pos: f64) -> (f64, f64, f64) {
+    if ramp.len() == 1 {
+        return ramp[0];
+    }
+    let last = ramp.len() - 1;
+    let pos = pos.clamp(0.0, 1.0);
+    let scaled = pos * last as f64;
+    let i = (scaled.floor() as usize).min(last.saturating_sub(1));
+    let t = scaled - i as f64;
+    let (r0, g0, b0) = ramp[i];
+    let (r1, g1, b1) = ramp[i + 1];
+    (r0 + (r1 - r0) * t, g0 + (g1 - g0) * t, b0 + (b1 - b0) * t)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_frame() {
+        let (v, p) = parse_frame(r#"{"v":[0.5,0.25],"p":[0.9,0.3]}"#);
+        assert_eq!(v, vec![0.5, 0.25]);
+        assert_eq!(p, vec![0.9, 0.3]);
+    }
+
+    #[test]
+    fn broken_frame_is_empty() {
+        assert_eq!(parse_frame("not json"), (Vec::new(), Vec::new()));
+        assert_eq!(parse_frame(""), (Vec::new(), Vec::new()));
+    }
+
+    #[test]
+    fn parses_hex_and_ramp() {
+        assert_eq!(parse_hex("#ff0000"), Some((1.0, 0.0, 0.0)));
+        assert_eq!(parse_hex("#f00"), Some((1.0, 0.0, 0.0)));
+        assert_eq!(parse_hex("zz"), None);
+        assert_eq!(parse_ramp("").len(), 1); // запасной цвет
+        assert_eq!(parse_ramp("#000000,#ffffff").len(), 2);
+    }
+
+    #[test]
+    fn ramp_interpolates() {
+        let ramp = parse_ramp("#000000,#ffffff");
+        let (r, g, b) = ramp_at(&ramp, 0.5);
+        assert!((r - 0.5).abs() < 1e-6 && (g - 0.5).abs() < 1e-6 && (b - 0.5).abs() < 1e-6);
+        assert_eq!(ramp_at(&ramp, 0.0), (0.0, 0.0, 0.0));
+        assert_eq!(ramp_at(&ramp, 1.0), (1.0, 1.0, 1.0));
+    }
+}
