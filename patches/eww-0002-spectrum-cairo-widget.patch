+const WIDGET_NAME_SPECTRUM: &str = "spectrum";
+/// @widget spectrum
+/// @desc Audio visualizer: rays grow left and right from a vertical centre, each end carries a peak dot
+fn build_spectrum(bargs: &mut BuilderArgs) -> Result<super::spectrum::Spectrum> {
+    let w = super::spectrum::Spectrum::new();
+    def_widget!(bargs, _g, w, {
+        // @prop data - frame from the visualizer script: {"v":[levels],"p":[peaks]}
+        prop(data: as_string) { w.set_property("data", data); },
+        // @prop ramp - comma separated hex colours, the gradient across frequencies
+        prop(ramp: as_string) { w.set_property("ramp", ramp); },
+    });
+    Ok(w)
+}
+
