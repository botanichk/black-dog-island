;; Eww Island — прототип 1 (X11 / XFCE)
;; Только чтение информации и переключение рабочих столов. Без трея и без резервирования места.

(defpoll clock :interval "1s" "date +%H:%M")
;; Текущая схема темы (theme/current). Нужна кнопке переключения: она
;; показывает глиф той темы, на которую переключит.
(defpoll theme-now :interval "10s" "cat $HOME/eww-island/theme/current")

;; Событийно: xprop -spy печатает индекс рабочего стола при каждом изменении.
(deflisten cur_ws :initial "0" "xprop -spy -root _NET_CURRENT_DESKTOP | sed -u -n 's/.*= //p'")
;; Путь раскрывает shell при выполнении: ${...}-интерполяция в конфиге здесь недоступна.
;; shortcut: путь привязан к ~/eww-island, при переносе конфига в ~/.config/eww его нужно обновить.

;; shortcut: громкость опрашивается раз в 2 с; при заметной нагрузке перейти на `pactl subscribe`.
(defpoll volume :interval "2s" "pactl get-sink-mute @DEFAULT_SINK@ | grep -q yes && echo MUTE || pactl get-sink-volume @DEFAULT_SINK@ | grep -o '[0-9]*%' | head -1")
;; Раскладка событийно: адаптер слушает XkbStateNotify через собственный X11-хелпер.
(deflisten panel_open :initial "false" "$HOME/eww-island/adapters/x11/panel-open.sh")

(deflisten layout :initial "" "$HOME/eww-island/adapters/x11/layout.sh")

;; Погода для выпадающей панели: Open-Meteo + координаты из Noctalia.
;; Данные кешируются адаптером на 10 минут, поэтому опрос чаще не нужен.
(defpoll w-city :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh city")
(defpoll w-temp :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh temp")
(defpoll w-feels :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh feels")
(defpoll w-desc :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh desc")
;; JPEG-фон верхней карточки: assets/wx-bg-<bg>.jpg, 16 видов
;; (ясно/переменно/облачно/морось/дождь/снег/туман/гроза, день и ночь).
;; Файлы делает scripts/build-weather-bg.sh из eww/assets/weather-src/.
;; :initial - чтобы до первого опроса не было пустого URL wx-bg-.jpg.
(defpoll w-bg :interval "30m" :initial "cloud-day" "$HOME/eww-island/adapters/weather/forecast.sh bg")
;; Затемнение фона под текстом: alpha 0.30-0.65, своё для каждого вида
;; (светлые сцены темнее, ночные почти без затемнения). См. shade_for в forecast.sh.
(defpoll w-shade :interval "30m" :initial "0.45" "$HOME/eww-island/adapters/weather/forecast.sh shade")
;; Вид фона верхней карточки (ясно/облачно/дождь/снег/туман/гроза + день/ночь).
;; Это запасной вариант: inline-стиль ниже перекрывает background-image класса.
;; Если inline-стиль убрать, градиент снова станет фоном карточки.
(defpoll wx-kind :interval "30m" :initial "clear-day" "$HOME/eww-island/adapters/weather/forecast.sh kind")
(defpoll w-wind :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh wind")
(defpoll w-hum :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh hum")
(defpoll w-d0name :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d0name")
(defpoll w-d0desc :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d0desc")
(defpoll w-d0icon :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d0icon")
(defpoll w-d0temp :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d0temp")
(defpoll w-d0sun :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d0sun")
(defpoll w-d0set :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d0set")
(defpoll w-d1name :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d1name")
(defpoll w-d1desc :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d1desc")
(defpoll w-d1icon :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d1icon")
(defpoll w-d1temp :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d1temp")
(defpoll w-d2name :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d2name")
(defpoll w-d2desc :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d2desc")
(defpoll w-d2icon :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d2icon")
(defpoll w-d2temp :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d2temp")
(defpoll w-d3name :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d3name")
(defpoll w-d3desc :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d3desc")
(defpoll w-d3icon :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d3icon")
(defpoll w-d3temp :interval "30m" "$HOME/eww-island/adapters/weather/forecast.sh d3temp")

;; Wi-Fi: список сетей через NetworkManager. Опрос раз в минуту, список меняется
;; медленно, а nmcli отвечает быстро.
;; :initial обязателен: цикл "for" читает значение при сборке, до первого опроса
;; переменная ещё пустая, и Eww спотыкается на разборе JSON.
(defpoll wf-state :interval "1m" :initial "отключено" "$HOME/eww-island/adapters/x11/wifi.sh state")
(defpoll wf-ssid :interval "1m" :initial "—" "$HOME/eww-island/adapters/x11/wifi.sh ssid")
(defpoll wf-signal :interval "1m" :initial "0" "$HOME/eww-island/adapters/x11/wifi.sh signal")
(defpoll wf-bars :interval "1m" :initial "▁" "$HOME/eww-island/adapters/x11/wifi.sh bars")
;; Уровень сигнала словом: от него зависят иконка (веер из дуг) и её цвет.
(defpoll wf-level :interval "1m" :initial "none" "$HOME/eww-island/adapters/x11/wifi.sh level")
(defpoll wf-n :interval "1m" :initial "0" "$HOME/eww-island/adapters/x11/wifi.sh n")
(defpoll wf-list :interval "1m" :initial "[]" "$HOME/eww-island/adapters/x11/wifi.sh list")
;; Радио Wi-Fi опрашиваем чаще остальных: выключатель должен отзываться на
;; переключение извне (nm-applet, hotkey) за секунды, а не за минуту.
;; Один вызов nmcli radio, стоимость ~20 мс.
(defpoll wf-radio :interval "3s" :initial "on" "$HOME/eww-island/adapters/x11/wifi.sh radio")
;; 1, если есть активное подключение. От этого зависит, спрашивать ли
;; подтверждение перед выключением радио.
(defpoll wf-active :interval "1m" :initial "0" "$HOME/eww-island/adapters/x11/wifi.sh active")
;; 1 - показываем в шапке подтверждение "выключить Wi-Fi?". Ставит адаптер
;; (radio-toggle), снимает - кнопка "Отмена" или само выключение. defvar, а не
;; defpoll: значение живёт только в интерфейсе.
(defvar wf_confirm 0)

;; Медиа: всё состояние вкладки одной строкой JSON (adapters/media/mpris.sh).
;; Опрос раз в 1 с - максимум из спеки (~90 мс на тик, как у home-опроса).
;; Переменную читает только вкладка медиа, поэтому при закрытом хабе defpoll
;; не работает и нагрузки нет.
(defpoll media :interval "1s"
  :initial "{\"player\":\"\",\"status\":\"none\",\"title\":\"\",\"artist\":\"\",\"album\":\"\",\"art\":\"\",\"pos\":0,\"len\":0,\"posfmt\":\"0:00\",\"lenfmt\":\"0:00\",\"canseek\":false,\"canprev\":false,\"cannext\":false,\"canpause\":false,\"players\":[]}"
  "$HOME/eww-island/adapters/media/mpris.sh json")

;; Календарь: текущая дата для виджета calendar.
(defpoll cal-day :interval "1h" "date +%d")
(defpoll cal-month :interval "1h" "date +%m")
(defpoll cal-year :interval "1h" "date +%Y")
;; Русская локаль даёт "%B" в родительном падеже ("ноября"), а в заголовке нужен
;; именительный. "%OB" - standalone-форма месяца: "Ноябрь".
(defpoll cal-month-name :interval "1h" "date '+%OB %Y'")
;; Полная дата для панели календаря: в острове только часы (HH:MM).
(defpoll cal-full :interval "1h" "date '+%A, %d %B %Y'")

;; Рабочие столы: четыре крупные круглые точки, активная - акцентная.
;; Точка - свой SVG: глиф "●" в Noto Sans вытягивается по высоте и получается
;; овал, а box с border-radius 50% растягивается по высоте тем более.
(defwidget wsdot [n]
  (button :class {cur_ws == n ? "wsdot active" : "wsdot"}
          :onclick "wmctrl -s ${n}"
          (image :class "wsdot-mark"
            :path {cur_ws == n ? "${EWW_CONFIG_DIR}/assets/wsdot-active.svg" : "${EWW_CONFIG_DIR}/assets/wsdot.svg"}
            :image-width 16 :image-height 16)))

;; Верхняя полоса с вогнутыми углами: углы 12x12 выходят за края тела на 12 px.
;; Тело получает отступ 0 12px, поэтому полоса шире тела ровно на два угла.
;; Углы - картинки assets/corner-*.svg: в GTK CSS радиальный градиент даёт размытую кромку.
(defwidget island-root []
  (box :orientation "vertical" :space-evenly false :class "island-shell"
    (box :orientation "horizontal" :space-evenly false :class "flare-row"
      (image :class "flare-left" :path "${EWW_CONFIG_DIR}/assets/corner-left.svg" :image-width 12 :image-height 12)
      (box :class "flare-band" :hexpand true)
      (image :class "flare-right" :path "${EWW_CONFIG_DIR}/assets/corner-right.svg" :image-width 12 :image-height 12))
    (box :orientation "horizontal" :space-evenly false :class {panel_open == "true" ? "island-root open" : "island-root"} :vexpand true
      ;; Колесо над точками листает столы. onscroll живёт только на eventbox,
      ;; аргумент приходит из патча eww-0001 ("up"/"down").
      (eventbox :onscroll "$HOME/eww-island/adapters/x11/ws-scroll.sh {}"
        (box :orientation "horizontal" :class "wsgroup"
          (wsdot :n "0")
          (wsdot :n "1")
          (wsdot :n "2")
          (wsdot :n "3")))
      (systray :class "tray" :orientation "h" :spacing 6 :icon-size 16
               :space-evenly false :prepend-new false)
      ;; Свободное место забирает растяжка: правая группа прижата к краю,
      ;; ширина окна держится константой ($island-w).
      (box :hexpand true)
      (box :orientation "horizontal" :space-evenly false :class "right"
        ;; Порядок правой группы задан владельцем: «Главная», раскладка, обои,
        ;; часы, громкость. Слева от группы - воркспейсы, трей и растяжка.
        ;;
        ;; «Главная»: открывает хаб на вкладке home. panel.sh сам решает -
        ;; открыть, переключить или закрыть. Кнопка подсвечена, пока хаб
        ;; открыт именно на главной (panel_open + hub_tab), как активная
        ;; вкладка в колонке. :timeout 3s - окно панели появляется не сразу.
        (button :class {panel_open == "true" && hub_tab == 0 ? "home-btn active" : "home-btn"}
          :timeout "3s"
          :onclick "$HOME/eww-island/adapters/x11/panel.sh panel-hub home"
          (label :class "home-btn-ic" :text ""))
        (button :class "layout" :onclick "$HOME/eww-island/adapters/x11/layout.sh next" layout)
        ;; Обои: глиф Meslo Nerd Font (картинка, U+F03E), как у остальных
        ;; кнопок острова. Команда запуска живёт в adapters/x11/wallpaper.sh:
        ;; уже открытое окно настройщика поднимается, копии не плодятся.
        (button :class "wall" :timeout "3s"
          :onclick "$HOME/eww-island/adapters/x11/wallpaper.sh"
          (label :class "wall-ic" :text ""))
        ;; Клик по Wi-Fi открывает список сетей. Иконка - свой SVG: веер из дуг,
        ;; уровень задаётся количеством дуг и цветом.
        ;; Клик по часам открывает хаб на вкладке календаря.
        ;; :timeout 3s - окно панели появляется не мгновенно, а команда кнопки
        ;; по умолчанию убивается через 200 мс.
        (button :class "clock" :timeout "3s"
          :onclick "$HOME/eww-island/adapters/x11/panel.sh panel-hub calendar"
          (label :text clock))
        ;; onscroll живёт только на eventbox: у button он удалён в Eww 0.6.
        (eventbox :onscroll "$HOME/eww-island/adapters/audio/volume.sh {}"
          (button :class "vol" :onclick "$HOME/eww-island/adapters/audio/volume.sh mute"
            (label :text volume)))))))

;; X11 игнорирует :anchor; центрирование выполняет scripts/run-island.sh через --pos.
;; Фактическую ширину задаёт содержимое (GTK), :width здесь справочный.
;; y=0: остров прижат к верхнему краю; панель XFCE временная и будет отключена.
(defwindow island
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "460px" :height "50px" :anchor "top left")
  :stacking "fg"
  :windowtype "dock"
  :reserve (struts :side "top" :distance "50px")
  :resizable false
  (island-root))

;; Прототип вогнутых верхних углов (этап 2). Временное окно: проверяем, что
;; вырез угла реально прозрачный и видно рабочий стол. Углы - отдельные SVG:
;; GTK3 CSS не умеет вогнутые радиусы, а radial-gradient даёт размытую кромку.
(defwindow proto-corners
  :monitor 0
  :geometry (geometry :x "420px" :y "220px" :width "320px" :height "90px")
  :stacking "fg"
  :windowtype "normal"
  (box :orientation "horizontal" :space-evenly false :class "proto"
    (image :class "proto-corner-l" :valign "start" :path "${EWW_CONFIG_DIR}/assets/panel-corner-left.svg" :image-width 16 :image-height 16)
    (box :class "proto-body" :hexpand true)
    (image :class "proto-corner-r" :valign "start" :path "${EWW_CONFIG_DIR}/assets/panel-corner-right.svg" :image-width 16 :image-height 16)))

;; Хаб: одна панель с вкладками (главная, календарь, погода, Wi-Fi, снимок, медиа), как в Noctalia.
;; hub_tab - индекс вкладки стека (stack :selected принимает число):
;; 0 = главная, 1 = календарь, 2 = погода, 3 = Wi-Fi, 4 = снимок, 5 = медиа.
;; Имена (home/calendar/weather/wifi/shot/media) использует panel.sh, в индекс
;; они переводятся там же.
;; Индекс медиа - 5, а не 1: это не сдвигает остальные вкладки (панель адаптеров
;; хранит индексы цифрами, например плитка Wi-Fi пишет hub_tab=3). В колонке
;; кнопка медиа стоит сразу после «Главной», порядок кнопок и стека независимы.
(defvar hub_tab 0)

;; --- вкладка «Главная» ---
;; Одна команда раз в 2 с на все состояния вкладки: шесть отдельных defpoll
;; запускали бы шесть процессов на каждый тик. JSON разбирается выражениями
;; Eww (home.volume, home.wifi, ...).
;; :initial с полным набором ключей обязателен: до первого опроса цикл и
;; :value читают значения при сборке, и отсутствующий ключ даёт ошибку разбора.
(defpoll home :interval "2s"
  :initial "{\"wifi\":\"no\",\"bt\":\"no\",\"mute\":\"no\",\"volume\":0,\"brightness\":0,\"temp\":0,\"charging\":\"no\"}"
  "$HOME/eww-island/adapters/system/home.sh all")

;; Плитка-переключатель: иконка сверху, подпись снизу, активное состояние -
;; плашка $primary. Клик уходит в adapters/system/home.sh set ...
(defwidget home-tile [glyph name on onclick]
  (button :class {on == "on" ? "home-tile active" : "home-tile"}
          :hexpand true :timeout "5s" :onclick onclick
    (box :orientation "vertical" :space-evenly false :class "home-tile-in" :halign "center" :valign "center"
      (label :class "home-tile-ic" :text glyph)
      (label :class "home-tile-name" :text name))))

;; Строка ползунка: глиф, scale на всю ширину, число процентов справа.
(defwidget home-slider [glyph value onclick]
  (box :orientation "horizontal" :space-evenly false :class "home-row" :halign "fill"
    (label :class "home-glyph" :text glyph)
    (scale :class "home-scale" :hexpand true :timeout "2s"
           :value value :min 0 :max 100 :round-digits 0
           :onchange onclick)
    (label :class "home-pct" :text "${round(value, 0)}%")))

;; Строка системы: глиф, название, полоска (progress), значение справа.
(defwidget home-sys [glyph name value text]
  (box :orientation "horizontal" :space-evenly false :class "home-sys" :halign "fill"
    (label :class "home-glyph" :text glyph)
    (label :class "home-sys-name" :text name)
    (progress :class "home-bar" :hexpand true :valign "center" :value value)
    (label :class "home-val" :text text)))

(defwidget home-content []
  (box :orientation "vertical" :space-evenly false :class "home-panel" :hexpand true :vexpand true
    (label :class "home-title" :xalign 0 :text "Быстрые настройки")
    ;; Верхний ряд плиток на всю ширину: три равные кнопки.
    (box :orientation "horizontal" :space-evenly false :class "home-tiles" :halign "fill"
      (home-tile :glyph ""
                 :name "Wi-Fi" :on {home.wifi}
                 :onclick "$HOME/eww-island/adapters/system/home.sh set wifi toggle")
      (home-tile :glyph ""
                 :name "Bluetooth" :on {home.bt == "yes" ? "on" : "off"}
                 :onclick "$HOME/eww-island/adapters/system/home.sh set bt toggle")
      (home-tile :glyph ""
                 :name "Звук" :on {home.mute == "no" ? "on" : "off"}
                 :onclick "$HOME/eww-island/adapters/system/home.sh set mute toggle"))
    ;; Ползунки: громкость и яркость, 0-100 (яркость не ниже 5 % - в скрипте).
    (box :orientation "vertical" :space-evenly false :class "home-sliders" :halign "fill"
      (home-slider :glyph ""
                   :value {home.volume}
                   :onclick "$HOME/eww-island/adapters/system/home.sh set volume {}")
      (home-slider :glyph ""
                   :value {home.brightness}
                   :onclick "$HOME/eww-island/adapters/system/home.sh set brightness {}"))
    ;; Блок системы: CPU, RAM, температура, батарея (со значком зарядки).
    (box :orientation "vertical" :space-evenly false :class "home-system" :halign "fill" :vexpand true :valign "start"
      (label :class "home-sub" :xalign 0 :text "Система")
      (home-sys :glyph ""
                :name "CPU" :value {round(EWW_CPU.avg, 0)} :text "${round(EWW_CPU.avg, 0)}%")
      (home-sys :glyph ""
                :name "RAM" :value {round(EWW_RAM.used_mem_perc, 0)} :text "${round(EWW_RAM.used_mem_perc, 0)}%")
      (home-sys :glyph ""
                :name "Температура" :value {home.temp} :text "${home.temp}°C")
      (home-sys :glyph {home.charging == "yes" ? "" : ""}
                :name "Батарея" :value {round(EWW_BATTERY.total_avg, 0)}
                :text "${round(EWW_BATTERY.total_avg, 0)}%"))))

;; --- вкладка «Снимок» ---
;; Задержка в секундах: 0, 3 или 5. Кнопки пишут сюда же.
(defvar shot_delay 0)
;; Миниатюра последнего снимка и его метка (YYYY-MM-DD_HH-MM-SS).
;; Это defpoll, а не defvar: команда выполняется на старте, поэтому после
;; `eww reload` миниатюра и метка восстанавливаются из кеша сами. После нового
;; снимка adapters/x11/screenshot.sh обновляет обе через `eww update`, и вкладка
;; перерисовывается без перезапуска. Путь уникален для каждого снимка: Eww
;; кеширует картинку по пути и с постоянным именем показал бы старую.
(defpoll shot_thumb :interval "1h" :initial ""
  "ls -1t $HOME/.cache/eww-island/thumbs/last-*.png 2>/dev/null | head -1")
(defpoll shot_stamp :interval "1h" :initial ""
  "ls -1t $HOME/.cache/eww-island/thumbs/last-*.png 2>/dev/null | head -1 | sed 's#.*/last-##; s#\\.png$##'")

;; Кнопка вкладки в левой колонке хаба: обновляет hub_tab напрямую.
(defwidget hub-tab-btn [idx glyph]
  (button :class {hub_tab == idx ? "hub-tab-btn active" : "hub-tab-btn"}
          :timeout "3s"
          :onclick "$HOME/eww-island/build/target/release/eww --config $HOME/eww-island/eww update hub_tab=${idx}"
          (label :class "hub-ic" :text glyph)))

;; Левая колонка вкладок хаба (~56 px). Кнопка медиа - сразу после
;; «Главной» (по спеке вкладки), её индекс в стеке 5.
;; Внизу, отдельно от вкладок, - переключатель темы (глиф солнца).
(defwidget hub-rail []
  (box :orientation "vertical" :space-evenly false :class "hub-rail"
    (hub-tab-btn :idx 0 :glyph "")
    (hub-tab-btn :idx 5 :glyph "")
    (hub-tab-btn :idx 1 :glyph "")
    (hub-tab-btn :idx 2 :glyph "")
    (hub-tab-btn :idx 3 :glyph "")
    (hub-tab-btn :idx 4 :glyph "")
    ;; Растяжка: тема уезжает к низу колонки, вкладки остаются сверху.
    (box :class "hub-rail-gap" :vexpand true)
    ;; Переключатель темы (шаг 2 тем). switch.sh помнит выбор в theme/current
    ;; и сам переоткрывает хаб на этой вкладке: reload закрывает окно и
    ;; сбрасывает hub_tab на 0.
    (button :class "hub-theme-btn" :timeout "8s"
            :tooltip {theme-now == "light" ? "Тема: light -> default" : "Тема: default -> light"}
            :onclick "$HOME/eww-island/theme/switch.sh"
      (label :class "hub-ic" :text {theme-now == "light" ? "" : ""}))))

;; Общая рамка панели: верх прямой (панель продолжает остров), низ скруглён.
;; Растяжка на обоих уровнях: содержимое панели занимает всё окно по высоте.
(defwidget panel-frame []
  (box :class "panel-frame" :orientation "vertical" :space-evenly false
       :hexpand true :vexpand true
    (box :class "panel-body" :orientation "vertical" :space-evenly false
         :hexpand true :vexpand true (children))))

;; Выпадающая панель календаря. Открывается по клику на часы (adapters/x11/panel.sh),
;; закрывается по клику в другое место (unfocus-close).
;; :windowtype utility - xfwm4 не центрирует такие окна, а ставит их сразу по --pos:
;; панель появляется уже под островом, без прыжка из центра экрана. Фокус utility
;; получает, поэтому unfocus-close работает.
;; Содержимое календаря: используется вкладкой хаба.
;; Слева сам календарь (растягивается), справа карточка "Сегодня":
;; число крупно, под ним строка даты (из неё день недели) и месяц с годом.
;; Все данные - существующие переменные, новых скриптов нет.
(defwidget cal-content []
  (box :orientation "horizontal" :space-evenly false :class "cal-panel" :halign "fill"
    (calendar :class "cal"
      :hexpand true :vexpand true
      :day cal-day :month cal-month :year cal-year
      :show-heading false :show-day-names true :show-week-numbers false :show-details false)
    (box :orientation "vertical" :space-evenly false :class "cal-today" :valign "center"
      (label :class "cal-today-num" :text cal-day)
      (label :class "cal-today-dow" :text cal-full)
      (label :class "cal-today-my" :text cal-month-name))))

;; Выпадающая панель погоды: текущая погода и прогноз на 4 дня.
;; Открывается по клику на индикатор погоды в острове (adapters/x11/panel.sh).
(defwidget wday [icon name desc temp]
  ;; Один день прогноза: иконка + день слева, температура справа (space-between
  ;; через hexpand на левой части), под ними - описание мелким кеглем.
  (box :orientation "vertical" :space-evenly false :class "wfc-row" :halign "fill" :vexpand true
    (box :orientation "horizontal" :space-evenly false :halign "fill"
      (box :orientation "horizontal" :space-evenly false :halign "start" :hexpand true
        (image :class "wfc-icon" :path "${EWW_CONFIG_DIR}/assets/cond-${icon}.svg" :image-width 16 :image-height 16)
        (label :class "wfc-name" :xalign 0 :text name))
      (label :class "wfc-temp" :halign "end" :text temp))
    (label :class "wfc-desc" :xalign 0 :text desc)))

;; Панель погоды в духе Noctalia: две колонки, слева текущие условия и детали,
;; справа прогноз на 4 дня. Ширины: левая колонка фиксированная (GTK3 CSS не
;; умеет ни flex, ни проценты), правая добирает остаток через hexpand.
;; Содержимое погоды: используется вкладкой хаба.
(defwidget wx-content []
  (box :orientation "horizontal" :space-evenly false :class "wx-panel" :halign "fill" :vexpand true
    ;; --- левая колонка: сейчас + детали ---
    ;; Верхняя карточка забирает остаток высоты, нижняя прижата вниз и растёт
    ;; только по содержимому (:vexpand false + valign end).
    (box :orientation "vertical" :space-evenly false :class "wx-left" :halign "fill" :vexpand true :width 330
      (label :class "wx-city" :xalign 0 :text w-city)
      ;; JPEG-фон сцены, герои (фонарь, Жулик) - в правой части кадра, поэтому
      ;; background-position 75% 50%: при обрезке cover правый край держится,
      ;; а лишнее уходит из левого. Слои сверху вниз: боковой градиент
      ;; (затемняет только левую часть под текстом, справа прозрачный),
      ;; равномерное затемнение (alpha из w-shade) и сама картинка.
      ;; background-size/position перечислены для каждого слоя по порядку.
      ;; Цвета затемнения - из colors.scss, поэтому не :style (он оборачивает
      ;; содержимое в "* { ... }", и @import внутри невозможен), а :css:
      ;; он компилируется как есть, абсолютный путь ${EWW_CONFIG_DIR}.
      (box :orientation "horizontal" :space-evenly false :class "wx-cur ${wx-kind}" :halign "fill" :vexpand true
        :css "@import \"${EWW_CONFIG_DIR}/colors.scss\"; * { background-image: linear-gradient(90deg, $wx-scrim, rgba($wx-ink, 0) 60%), linear-gradient(rgba($wx-ink, ${w-shade}), rgba($wx-ink, ${w-shade})), url('file://${EWW_CONFIG_DIR}/assets/wx-bg-${w-bg}.jpg'); background-size: 100% 100%, 100% 100%, cover; background-position: left top, left top, 75% 50%; }"
        ;; Текст (задание 07): без иконки и подложки, столбцом в левом верхнем
        ;; углу карточки - температура, описание, диапазон дня.
        (box :orientation "vertical" :space-evenly false :class "wx-cur-main" :halign "start" :valign "start" :hexpand true
          (label :class "wx-cur-temp" :xalign 0 :text "${w-temp}°")
          (label :class "wx-cur-desc" :xalign 0 :text w-desc)
          (label :class "wx-cur-range" :xalign 0 :text "${w-d0temp}°")))
      (box :orientation "vertical" :space-evenly false :class "wx-details" :halign "fill" :vexpand false :valign "end"
        (box :orientation "horizontal" :space-evenly false :class "wx-detail-row" :halign "fill"
          (label :class "wx-dk" :xalign 0 :hexpand true :text "Ощущается")
          (label :class "wx-dv" :halign "end" :text "${w-feels}°"))
        (box :orientation "horizontal" :space-evenly false :class "wx-detail-row" :halign "fill"
          (label :class "wx-dk" :xalign 0 :hexpand true :text "Ветер")
          (label :class "wx-dv" :halign "end" :text "${w-wind} км/ч"))
        (box :orientation "horizontal" :space-evenly false :class "wx-detail-row" :halign "fill"
          (label :class "wx-dk" :xalign 0 :hexpand true :text "Влажность")
          (label :class "wx-dv" :halign "end" :text "${w-hum}%"))
        (box :orientation "horizontal" :space-evenly false :class "wx-detail-row" :halign "fill"
          (label :class "wx-dk" :xalign 0 :hexpand true :text "Восход / закат")
          (label :class "wx-dv" :halign "end" :text "${w-d0sun} / ${w-d0set}"))))

    ;; --- правая колонка: прогноз; заголовок прижат к верху, дни делят высоту ---
    (box :orientation "vertical" :space-evenly false :class "wx-right" :halign "fill" :hexpand true :vexpand true
      (label :class "wx-fc-label" :xalign 0 :text "ПРОГНОЗ")
      (wday :icon w-d0icon :name w-d0name :desc w-d0desc :temp "${w-d0temp}°")
      (wday :icon w-d1icon :name w-d1name :desc w-d1desc :temp "${w-d1temp}°")
      (wday :icon w-d2icon :name w-d2name :desc w-d2desc :temp "${w-d2temp}°")
      (wday :icon w-d3icon :name w-d3name :desc w-d3desc :temp "${w-d3temp}°"))))

;; Выпадающая панель Wi-Fi: текущая сеть и список доступных.
;; Список приходит из адаптера как JSON-массив, цикл "for" разворачивает его
;; в строки. Клик по сети подключается к ней (nmcli умеет подключаться к сетям
;; с сохранённым профилем; к остальным нужен пароль, его ввести негде).
;; Содержимое Wi-Fi: используется вкладкой хаба.
;;
;; Три состояния шапки, переключаются через "for" (не ":visible" - в этой
;; сборке Eww он применяется один раз при первом показе и не обновляется):
;;   1) подтверждение выключения (wf_confirm = 1) - "Выключить"/"Отмена";
;;   2) радио выключено - "Wi-Fi выключен" и кнопка "Включить";
;;   3) обычный режим - переключатель, активная сеть и список.
(defwidget wf-content []
  (box :orientation "vertical" :space-evenly false :class "wf-panel"
    ;; --- 1. Подтверждение выключения, пока есть активное подключение ---
    (for z in {wf_confirm == 1 ? "[1]" : "[]"}
      (box :orientation "vertical" :space-evenly false :class "wf-ask"
        (label :class "wf-ask-title" :xalign 0 :text "Выключить Wi-Fi?")
        (label :class "wf-ask-text" :xalign 0 :wrap true
               :text "Активное подключение «${wf-ssid}» оборвётся. Профиль сети сохранится.")))
    (for z in {wf_confirm == 1 ? "[1]" : "[]"}
      (box :orientation "horizontal" :space-evenly false :class "wf-ask-row" :halign "fill"
        (button :class "wf-btn danger" :hexpand true :timeout "5s"
          :onclick "$HOME/eww-island/adapters/x11/wifi.sh radio off"
          (label :text "Выключить"))
        (button :class "wf-btn ghost" :hexpand true :timeout "5s"
          :onclick "$HOME/eww-island/build/target/release/eww --config $HOME/eww-island/eww update wf_confirm=0"
          (label :text "Отмена"))))
    ;; --- 2. Радио выключено: списка нет, вместо него пустое состояние ---
    (for z in {wf-radio != "on" && wf_confirm == 0 ? "[1]" : "[]"}
      (box :orientation "vertical" :space-evenly false :class "wf-off" :vexpand true :valign "center"
        (label :class "wf-off-ic" :text "")
        (label :class "wf-off-title" :text "Wi-Fi выключен")
        (label :class "wf-off-text" :text "Список сетей скрыт, пока радио выключено")
        (button :class "wf-btn accent" :timeout "5s"
          :onclick "$HOME/eww-island/adapters/x11/wifi.sh radio on"
          (label :text "Включить"))))
    ;; --- 3. Обычный режим: переключатель, активная сеть, список ---
    (for z in {wf-radio == "on" && wf_confirm == 0 ? "[1]" : "[]"}
      (box :orientation "vertical" :space-evenly false :class "wf-main"
        (box :orientation "horizontal" :space-evenly false :class "wf-head" :halign "fill"
          (image :class "wf-icon" :path "${EWW_CONFIG_DIR}/assets/wifi-${wf-level}.svg" :image-width 16 :image-height 16)
          (box :orientation "vertical" :space-evenly false :hexpand true
            (label :class "wf-ssid" :xalign 0 :text wf-ssid)
            (label :class "wf-state" :xalign 0 :text "${wf-state} · сигнал ${wf-signal}%"))
          ;; Переключатель радио: клик уходит в адаптер, он сам решает -
          ;; выключить сразу или спросить подтверждение (есть активная сеть).
          (button :class "wf-radio on" :timeout "5s"
            :onclick "$HOME/eww-island/adapters/x11/wifi.sh radio-toggle"
            (label :class "wf-radio-ic" :text "")))
        (box :orientation "horizontal" :space-evenly false :class "wf-actions" :halign "fill"
          ;; Отключение активной сети, профиль сохраняется.
          (button :class "wf-btn ghost" :hexpand true :timeout "8s"
            :onclick "$HOME/eww-island/adapters/x11/wifi.sh disconnect"
            (label :text "Отключиться"))
          ;; Перечитать список без смены радио: принудительный опрос defpoll.
          (button :class "wf-btn ghost" :hexpand true :timeout "5s"
            :onclick "$HOME/eww-island/adapters/x11/wifi.sh rescan"
            (label :text "Обновить")))
        (box :orientation "horizontal" :space-evenly false :class "wf-sep")
        (scroll :vscroll true :hscroll false :height 200 :vexpand true :class "wf-scroll"
          (box :orientation "vertical" :space-evenly false :class "wf-list"
          (for net in {wf-radio == "on" && wf_confirm == 0 ? wf-list : "[]"}
            ;; Кнопка в Eww принимает только одного ребёнка, поэтому строка - это box.
            ;; Высота строки - минимальная (CSS), сама не растягивается.
            (button :class {net.active ? "wf-net active" : "wf-net"}
              :onclick "$HOME/eww-island/adapters/x11/wifi.sh connect ${net.idx}"
              (box :orientation "horizontal" :space-evenly false :hexpand true
                (image :class "wf-net-icon" :path "${EWW_CONFIG_DIR}/assets/wifi-${net.level}.svg" :image-width 14 :image-height 14)
                (label :class "wf-net-name" :xalign 0 :halign "start" :hexpand true :text "${net.ssid}")
                (label :class "wf-net-sig" :xalign 1 :halign "end" :text "${net.sig}%"))))))))))

;; --- вкладка «Снимок» ---
;; Кнопки запускают скрипт отвязанно (setsid -f): у кнопки Eww команда
;; убивается по таймауту (по умолчанию 200 мс), а выбор области мышью и
;; задержка длятся секунды. Скрипт сам закрывает хаб перед кадром, чтобы
;; панель не попала на снимок.
(defwidget shot-delay-btn [sec]
  (button :class {shot_delay == sec ? "shot-seg active" : "shot-seg"}
          :timeout "3s"
          :onclick "$HOME/eww-island/build/target/release/eww --config $HOME/eww-island/eww update shot_delay=${sec}"
          (label :text "${sec} с")))

(defwidget shot-content []
  (box :orientation "vertical" :space-evenly false :class "shot-panel" :hexpand true :vexpand true
    (label :class "shot-title" :xalign 0 :text "Снимок экрана")
    (label :class "shot-hint" :xalign 0
           :text "Область или Окно - выделить мышью, Esc отменяет")
    ;; Три режима: область и окно - один и тот же import без -window,
    ;; разные только подпись и подсказка.
    (box :orientation "horizontal" :space-evenly false :class "shot-modes" :halign "fill"
      (button :class "shot-btn" :hexpand true :timeout "10s"
              :onclick "setsid -f $HOME/eww-island/adapters/x11/screenshot.sh area ${shot_delay} >/dev/null 2>&1"
        (label :text "Область"))
      (button :class "shot-btn" :hexpand true :timeout "10s"
              :onclick "setsid -f $HOME/eww-island/adapters/x11/screenshot.sh window ${shot_delay} >/dev/null 2>&1"
        (label :text "Окно"))
      (button :class "shot-btn" :hexpand true :timeout "10s"
              :onclick "setsid -f $HOME/eww-island/adapters/x11/screenshot.sh screen ${shot_delay} >/dev/null 2>&1"
        (label :text "Весь экран")))
    ;; Задержка 0/3/5 с, выбранная подсвечена акцентом.
    (box :orientation "horizontal" :space-evenly false :class "shot-delay" :halign "fill"
      (label :class "shot-delay-cap" :xalign 0 :hexpand true :text "Задержка")
      (shot-delay-btn :sec 0)
      (shot-delay-btn :sec 3)
      (shot-delay-btn :sec 5))
    ;; Миниатюра последнего снимка: 160 px по ширине, пропорции сохраняются.
    (box :orientation "vertical" :space-evenly false :class "shot-thumb"
         :halign "fill" :vexpand true :visible {shot_thumb != ""}
      (label :class "shot-cap" :xalign 0 :text "Последний снимок")
      (label :class "shot-stamp" :xalign 0 :text shot_stamp)
      (box :orientation "vertical" :class "shot-img-box" :halign "center" :valign "center" :vexpand true
        (image :class "shot-img" :path shot_thumb :image-width 160)))
    ;; Пока снимков не было - вместо миниатюры пояснение.
    (label :class "shot-empty" :vexpand true :valign "center"
           :text "Снимков ещё нет" :visible {shot_thumb == ""})
    (box :orientation "horizontal" :space-evenly false :class "shot-foot" :halign "fill"
      (button :class "shot-btn ghost" :hexpand true :timeout "5s"
              :onclick "setsid -f $HOME/eww-island/adapters/x11/screenshot.sh open >/dev/null 2>&1"
        (label :text "Открыть"))
      ;; xclip остаётся в памяти и держит selection, поэтому кнопка отвязана:
      ;; иначе Eww убьёт команду по таймауту и буфер опустеет.
      (button :class "shot-btn ghost" :hexpand true :timeout "5s"
              :onclick "setsid -f $HOME/eww-island/adapters/x11/screenshot.sh copy >/dev/null 2>&1"
        (label :text "Копировать"))
      (button :class "shot-btn ghost" :hexpand true :timeout "5s"
              :onclick "setsid -f $HOME/eww-island/adapters/x11/screenshot.sh folder >/dev/null 2>&1"
        (label :text "Папка")))))

;; --- вкладка «Медиа» (MPRIS) ---
;; Всё состояние - переменная media (JSON адаптера). Название и исполнитель
;; попадают только в :text - в командах кнопок их нет, кнопки знают лишь имя
;; действия (prev/playpause/next) и цифры от ползунка.
;; Кнопка-иконка: глиф, класс off у неспособных плееров (CanGo*/CanPause).
(defwidget media-btn [glyph action cls disabled]
  (button :class {disabled ? cls + " off" : cls}
          :timeout "3s"
          :onclick "setsid -f $HOME/eww-island/adapters/media/mpris.sh ${action} >/dev/null 2>&1"
    (label :class "media-btn-ic" :text glyph)))

;; Два состояния, переключаются через "for" (не ":visible" - он в этой сборке
;; применяется один раз при первом показе): пустое и обычное.
(defwidget media-content []
  (box :orientation "vertical" :space-evenly false :class "media-panel" :hexpand true :vexpand true
    ;; Пустое состояние: плееров нет (или плеер закрылся посреди работы).
    (for z in {media.status == "none" ? "[1]" : "[]"}
      (box :orientation "vertical" :space-evenly false :class "media-off" :halign "center" :valign "center" :hexpand true :vexpand true
        (label :class "media-off-ic" :text "")
        (label :class "media-off-title" :text "Ничего не играет")
        (label :class "media-off-text" :text "Запустите плеер - он появится здесь")))
    ;; Обычный режим.
    (for z in {media.status != "none" ? "[1]" : "[]"}
      (box :orientation "vertical" :space-evenly false :hexpand true :vexpand true
        ;; Переключатель плеера: клик - следующий по кругу, выбор помнит адаптер.
        (box :orientation "horizontal" :space-evenly false :class "media-head" :halign "fill"
          (label :class "media-cap" :text "ПЛЕЕР")
          (button :class "media-player-chip" :timeout "3s" :halign "end" :hexpand true
                  :onclick "$HOME/eww-island/adapters/media/mpris.sh next-player >/dev/null"
            (label :class "media-player-name" :text "${media.player}")))
        (box :orientation "horizontal" :space-evenly false :class "media-body" :halign "fill" :vexpand true
          ;; Слот обложки: статичная обёртка. Дети "for" в этой сборке Eww
          ;; добавляются в конец родителя при пересборке, поэтому без обёртки
          ;; обложка уехала бы направо, после media-info.
          (box :orientation "horizontal" :space-evenly false :class "media-art-slot"
            ;; Обложка 200x200, скруглена; нет обложки - плита с нотой.
            (for z in {media.art != "" ? "[1]" : "[]"}
              (image :class "media-art" :path {media.art} :image-width 200 :image-height 200))
            (for z in {media.art == "" ? "[1]" : "[]"}
              (box :orientation "vertical" :class "media-art-fallback" :halign "start" :valign "start"
                (label :class "media-art-fallback-ic" :text ""))))
          (box :orientation "vertical" :space-evenly false :class "media-info" :hexpand true :valign "start"
            (label :class "media-title" :xalign 0 :limit-width 40 :text "${media.title}")
            (label :class "media-artist" :xalign 0 :limit-width 44 :text "${media.artist}")
            (label :class "media-album" :xalign 0 :limit-width 44 :text "${media.album}")
            ;; Ползунок позиции: с CanSeek - scale с перемоткой, без - полоска
            ;; "только показывает". Держим в правой колонке, чтобы высота вкладки
            ;; не росла (окно хаба должно остаться 358 px).
            (for z in {media.canseek ? "[1]" : "[]"}
              (box :orientation "horizontal" :space-evenly false :class "media-seekrow" :halign "fill"
                (scale :class "media-scale" :hexpand true :valign "center"
                       :value {media.pos} :min 0 :max {media.len > 0 ? media.len : 1} :round-digits 0
                       :timeout "2s" :onchange "$HOME/eww-island/adapters/media/mpris.sh seek {}")
                (label :class "media-time" :text "${media.posfmt} / ${media.lenfmt}")))
            (for z in {media.canseek ? "[]" : "[1]"}
              (box :orientation "horizontal" :space-evenly false :class "media-seekrow" :halign "fill"
                (progress :class "media-bar" :hexpand true :valign "center"
                          :value {media.len > 0 ? round(media.pos * 100 / media.len, 0) : 0})
                (label :class "media-time" :text "${media.posfmt} / ${media.lenfmt}")))))
        ;; Ряд кнопок под обложкой: предыдущий, пауза/играть, следующий.
        (box :orientation "horizontal" :space-evenly false :class "media-controls" :halign "center"
          (media-btn :glyph "" :action "prev" :cls "media-btn" :disabled {!media.canprev})
          (media-btn :glyph {media.status == "playing" ? "" : ""} :action "playpause" :cls "media-btn play" :disabled {!media.canpause})
          (media-btn :glyph "" :action "next" :cls "media-btn" :disabled {!media.cannext}))))))

;; Хаб: вкладки calendar / weather / wifi / shot / media в одном окне. Содержимое - общие
;; виджеты cal-content / wx-content / wf-content / shot-content / media-content. Растяжка по всей цепочке
;; (окно -> panel-frame -> hub-panel -> stack -> вкладка): вкладка занимает
;; всё окно, размер окна от вкладки не зависит (scroll :height задаёт минимум).
;; Обёртка .hub-tab - один класс с одинаковыми отступами для всех вкладок.
(defwindow panel-hub [w]
  :monitor 0
  :geometry (geometry :x "0px" :y "50px" :width w)
  :stacking "fg"
  :windowtype "normal"
  :unfocus-close true
  (panel-frame
    (box :orientation "horizontal" :space-evenly false :class "hub-panel"
         :hexpand true :vexpand true
      (hub-rail)
      (stack :selected hub_tab :transition "crossfade" :same-size true
             :hexpand true :vexpand true
        (scroll :height 330 :hexpand true :vexpand true :vscroll true :hscroll false
                :class "hub-tab-body"
          (box :orientation "vertical" :class "hub-tab" :hexpand true :vexpand true
            (home-content)))
        (scroll :height 330 :hexpand true :vexpand true :vscroll true :hscroll false
                :class "hub-tab-body"
          (box :orientation "vertical" :class "hub-tab" :hexpand true :vexpand true
            (cal-content)))
        (scroll :height 330 :hexpand true :vexpand true :vscroll true :hscroll false
                :class "hub-tab-body"
          (box :orientation "vertical" :class "hub-tab" :hexpand true :vexpand true
            (wx-content)))
        (scroll :height 330 :hexpand true :vexpand true :vscroll true :hscroll false
                :class "hub-tab-body"
          (box :orientation "vertical" :class "hub-tab" :hexpand true :vexpand true
            (wf-content)))
        (scroll :height 330 :hexpand true :vexpand true :vscroll true :hscroll false
                :class "hub-tab-body"
          (box :orientation "vertical" :class "hub-tab" :hexpand true :vexpand true
            (shot-content)))
        (scroll :height 330 :hexpand true :vexpand true :vscroll true :hscroll false
                :class "hub-tab-body"
          (box :orientation "vertical" :class "hub-tab" :hexpand true :vexpand true
            (media-content)))))))
